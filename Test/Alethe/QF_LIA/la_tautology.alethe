(assume a0 (<= x 2))
(assume a1 (>= x 5))
(assume a2 (not (<= (+ y 1) (+ y 3))))
(step t1 (cl (or (not (<= x 2)) (not (>= x 5)))) :rule la_tautology)
(step t2 (cl (or (not (<= x 2)) (<= x 3))) :rule la_tautology)
(step t3 (cl (or (not (>= x 5)) (>= x 4))) :rule la_tautology)
(step t4 (cl (or (<= x 2) (not (<= x 2)))) :rule la_tautology)
(step t5 (cl (or (>= x 5) (not (>= x 5)))) :rule la_tautology)
(step t6 (cl (<= (+ y 1) (+ y 3))) :rule la_tautology)
(step t7 (cl (< (+ y 1) (+ y 3))) :rule la_tautology)
(step t8 (cl (not (= (+ y 1) (+ y 3)))) :rule la_tautology)
(step t9 (cl (>= (+ y 3) (+ y 1))) :rule la_tautology)
(step t10 (cl (> (+ y 3) (+ y 1))) :rule la_tautology)
(step t11 (cl (not (<= x 2)) (not (>= x 5))) :rule or :premises (t1))
(step t12 (cl) :rule resolution :premises (t11 a0 a1))
