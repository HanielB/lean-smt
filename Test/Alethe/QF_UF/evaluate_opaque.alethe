(assume h1 (and (and p false) (and (or p (and q true)) (and (<= 5 3) p))))
(step t1 (cl (= (and p false) false)) :rule evaluate)
(step t2 (cl (= (or p (and q true)) (or p q))) :rule evaluate)
(step t3 (cl (= (and (<= 5 3) p) false)) :rule evaluate)
(step t4 (cl (= (<= 5 3) false)) :rule evaluate)
(step t5 (cl (= (- x y) (- x y))) :rule evaluate)
(step t6 (cl (and p false)) :rule and :premises (h1) :args (0))
(step t7 (cl (not (= (and p false) false)) (not (and p false)) false) :rule equiv_pos2)
(step t8 (cl false) :rule resolution :premises (t7 t1 t6))
(step t9 (cl (not false)) :rule false)
(step t10 (cl) :rule resolution :premises (t8 t9))
