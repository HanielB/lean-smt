(assume a0 (and p false q))
(assume a1 (or r (or true p)))
(step t1 (cl (= (and p false q) false)) :rule semilattice_simp)
(step t2 (cl (= (or r (or true p)) true)) :rule semilattice_simp)
(step t3 (cl (= (and (and p q) (and q true p)) (and q p))) :rule semilattice_simp)
(step t4 (cl (not (and p false q)) false) :rule equiv1 :premises (t1))
(step t5 (cl (not false)) :rule false)
(step t6 (cl (not (and p false q))) :rule resolution :premises (t4 t5) :args (false true))
(step t7 (cl) :rule resolution :premises (t6 a0) :args ((and p false q) true))
