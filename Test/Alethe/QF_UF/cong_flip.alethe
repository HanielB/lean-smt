(assume a0 (= a d))
(assume a1 (= b c))
(assume a2 (P (= a b)))
(assume a3 (not (P (= c d))))
(assume a4 (= a b))
(assume a5 (not (= b a)))
(step t1 (cl (= a a)) :rule refl)
(step t2 (cl (= (= a b) (= b a))) :rule cong :premises (t1))
(step t3 (cl (not (= (= a b) (= b a))) (not (= a b)) (= b a)) :rule equiv_pos2)
(step t4 (cl (= (= a b) (= c d))) :rule cong :premises (a0 a1))
(step t5 (cl (= (P (= a b)) (P (= c d)))) :rule cong :premises (t4))
(step t6 (cl (not (= (P (= a b)) (P (= c d)))) (not (P (= a b))) (P (= c d))) :rule equiv_pos2)
(step t7 (cl (= (= d c) (= a b))) :rule cong :premises (a0 a1))
(step t8 (cl (= (= d c) (= b a))) :rule cong :premises (a0 a1))
(step t9 (cl) :rule resolution :premises (t3 t2 a4 a5))
