(assume h1 (or (not p) p))
(assume h2 p)
(assume h3 (not q))
(assume h4 (or (not p) q))
(step t1 (cl (not p) p) :rule or :premises (h1))
(step t2 (cl (not p) q) :rule or :premises (h4))
(step t3 (cl p) :rule resolution :premises (h2 t1) :args (p true))
(step t4 (cl q) :rule resolution :premises (t3 t2) :args (p true))
(step t5 (cl) :rule resolution :premises (t4 h3) :args (q true))
