(assume h1 (forall ((x Int)) (or (p x) (forall ((y Int)) (q x y)))))
(assume h2 (not (forall ((y Int)) (or (p y) (forall ((z Int)) (q y z))))))
(anchor :step t1 :args ((y Int) (:= (x Int) y)))
(anchor :step t1.t1 :args ((z Int) (:= (y Int) z)))
(step t1.t1.t1 (cl (= (! (q x y) :named @p_1) (q y z))) :rule refl)
(step t1.t1 (cl (= (forall ((y Int)) @p_1) (forall ((z Int)) (q y z)))) :rule bind)
(step t1.t2 (cl (= (p x) (p y))) :rule refl)
(step t1.t3 (cl (= (or (p x) (forall ((y Int)) @p_1)) (or (p y) (forall ((z Int)) (q y z))))) :rule cong :premises (t1.t2 t1.t1))
(step t1 (cl (= (forall ((x Int)) (or (p x) (forall ((y Int)) (q x y)))) (forall ((y Int)) (or (p y) (forall ((z Int)) (q y z)))))) :rule bind)
(step t2 (cl (not (= (forall ((x Int)) (or (p x) (forall ((y Int)) (q x y)))) (forall ((y Int)) (or (p y) (forall ((z Int)) (q y z)))))) (not (forall ((x Int)) (or (p x) (forall ((y Int)) (q x y))))) (forall ((y Int)) (or (p y) (forall ((z Int)) (q y z))))) :rule equiv_pos2)
(step t3 (cl) :rule resolution :premises (t1 t2 h1 h2))
